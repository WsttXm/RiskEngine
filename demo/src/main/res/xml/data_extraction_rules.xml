<?xml version="1.0" encoding="utf-8"?>
<!--
  Host backup & device-transfer exclusion rules.
  Critically excludes RiskEngine's DirectBoot / Keystore-bound SharedPreferences
  (riskengine_fp.xml) so app-data cloning or cloud restore never copies device-bound
  ciphertext across devices and triggers device_binding_broken.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="riskengine_fp.xml" />
        <exclude domain="device_sharedpref" path="riskengine_fp.xml" />
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="riskengine_fp.xml" />
        <exclude domain="device_sharedpref" path="riskengine_fp.xml" />
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
